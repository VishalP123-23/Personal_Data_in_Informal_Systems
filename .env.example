# Environment Configuration Template
APP_ENV=local-demo

# Database connection:
# DATABASE_URL=postgresql+psycopg://username:password@127.0.0.1:5432/clinic_privacy
# For Neon / Supabase:
# DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Cryptographic Keys (generate unique random keys):
SECRET_KEY=
PERSONAL_DATA_KEY=

# Cookie & CORS Settings:
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=8
ALLOWED_ORIGIN=http://127.0.0.1:5173
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
